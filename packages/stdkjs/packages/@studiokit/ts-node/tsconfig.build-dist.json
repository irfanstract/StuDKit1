// This tsconfig.json drives compiling the src/ directory into the dist/ directory
{
  "extends": "./tsconfig.json",
  "references": [{
    "path": "./tsconfig.build-dist-raw.json"
  }],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "temp/tsconfig.build-dist.tsbuildinfo",
    "allowJs": false,
    "noCheck": true,
    // "declaration": false,
    "rootDirs": ["temp", "."]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    /* exclude the test-file(s) from this main-src config - there're a very large number of those */
    "src/test/**/*",
    /* exclude swcc-dependent stuffs */
    "src/**/*swc*",
  ]
}
