{
  "extends": "../../tsconfig.json" ,
  "compilerOptions": {
    "allowJs": true,
    "moduleResolution": "node16",

    /* to avoid the so-called complaints "referenced file is not under root dir", we need to stick to Project References, */
    /* https://www.typescriptlang.org/docs/handbook/project-references.html */
    "composite": true ,
    /* "referenced project may not disable emit" */
    /* https://stackoverflow.com/a/77369498 (in https://stackoverflow.com/q/71704754 ) */
    "noEmit": false,
    "emitDeclarationOnly": true,
    "checkJs": true,
    "allowSyntheticDefaultImports": true ,
    /* necessary  */
    "allowImportingTsExtensions": false ,
    /* https://stackoverflow.com/a/61513685 */
    // "rootDir": "src" , /* moved into 'tsconfig.build.json' --- per https://stackoverflow.com/q/35470511 focused at https://stackoverflow.com/a/60223923 */
    "outDir": "dist",

  },
  "references": [
    // { "path": "../../packages/typexpe-commons/tsconfig.build.json", } ,
  ] ,
  /* see also https://stackoverflow.com/q/35470511 focused at https://stackoverflow.com/a/60223923 */
  /* see also https://stackoverflow.com/q/60943069 focused at https://stackoverflow.com/a/61153019 */
  "include": [
    "**/*",
  ],
  "exclude": [
    "node_modules/**/*",
    ".node_modules/**/*",
  ],
}
